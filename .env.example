# Copy to .env.local and fill in from the Firebase console once phase 0 is done.
# .env.local is gitignored; this file is not, and must never hold real values.
#
# Leave every line blank and the app runs local-only, exactly as it did in phase 1:
# no sign-in step, Things stored on the device. See src/lib/firebase-config.ts.
#
# EXPO_PUBLIC_ variables are inlined into the client bundle, so nothing secret belongs here.
# The Firebase web config is designed to be public — access is controlled by Firestore
# security rules, not by hiding these. The OAuth refresh token is the actual secret and it
# never leaves the Cloud Function.

# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Optional: without them, email/password sign-in still works and the Google button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
